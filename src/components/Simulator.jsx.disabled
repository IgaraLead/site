import { useCallback, useEffect, useMemo, useRef, useState } from 'react';
import { mailtoLeadInquiry } from '../contactMailto';
import {
  DashboardView,
  ConversationsView,
  CnpjView,
  deriveSimPalette,
  deriveSimPaletteLight,
} from './simViews';

/* ─── Palette definitions ──────────────────────────────────── */

const PALETTES = [
  { id: 'igara', name: 'Igara', primary: '#0A8BCC', secondary: '#43655a' },
  { id: 'ocean', name: 'Oceano', primary: '#0c5be9', secondary: '#0891b2' },
  { id: 'sunset', name: 'Entardecer', primary: '#f97316', secondary: '#dc2626' },
  { id: 'lavender', name: 'Lavanda', primary: '#a855f7', secondary: '#6366f1' },
  { id: 'slate', name: 'Pedra', primary: '#64748b', secondary: '#334155' },
];

/* ─── Mark Icon ────────────────────────────────────────────── */

function Mark() {
  return (
    <svg
      viewBox="0 0 24 24"
      width="16"
      height="16"
      aria-hidden
      style={{ display: 'block', flexShrink: 0 }}
    >
      <rect x="2" y="4" width="3.5" height="16" rx="1" fill="currentColor" />
      <rect x="10.25" y="4" width="3.5" height="16" rx="1" fill="currentColor" />
      <rect x="18.5" y="4" width="3.5" height="16" rx="1" fill="currentColor" />
    </svg>
  );
}

/* ─── Layout Selector Icons ────────────────────────────────── */

function LayoutIcon({ type }) {
  if (type === 'dashboard')
    return (
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        strokeWidth="1.5"
        strokeLinecap="round"
        strokeLinejoin="round"
      >
        <rect x="3" y="3" width="7" height="7" rx="1.5" />
        <rect x="14" y="3" width="7" height="7" rx="1.5" />
        <rect x="3" y="14" width="7" height="7" rx="1.5" />
        <rect x="14" y="14" width="7" height="7" rx="1.5" />
      </svg>
    );
  if (type === 'conversations')
    return (
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        strokeWidth="1.5"
        strokeLinecap="round"
        strokeLinejoin="round"
      >
        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
      </svg>
    );
  return (
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      strokeWidth="1.5"
      strokeLinecap="round"
      strokeLinejoin="round"
    >
      <circle cx="11" cy="11" r="8" />
      <line x1="21" y1="21" x2="16.65" y2="16.65" />
    </svg>
  );
}

/* ─── Main Simulator ───────────────────────────────────────── */

export default function Simulator() {
  const [name, setName] = useState('');
  const [layout, setLayout] = useState('dashboard');
  const [paletteId, setPaletteId] = useState('igara');
  const [previewDark, setPreviewDark] = useState(true);
  const [logoUrl, setLogoUrl] = useState(null);
  const controlsRef = useRef(null);
  const [controlsHeight, setControlsHeight] = useState(0);
  const fileRef = useRef(null);

  useEffect(() => {
    if (!controlsRef.current) return;
    const ro = new ResizeObserver(entries => {
      for (const entry of entries) {
        setControlsHeight(entry.contentRect.height);
      }
    });
    ro.observe(controlsRef.current);
    return () => ro.disconnect();
  }, []);

  const palette = PALETTES.find(p => p.id === paletteId);
  const primary = palette.primary;
  const secondary = palette.secondary;

  const displayName = useMemo(() => name.trim() || 'Sua Empresa', [name]);

  const simPalette = useMemo(
    () =>
      previewDark
        ? deriveSimPalette(primary, secondary)
        : deriveSimPaletteLight(primary, secondary),
    [primary, secondary, previewDark]
  );

  const handleLogoUpload = useCallback(e => {
    const file = e.target.files?.[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = () => setLogoUrl(reader.result);
    reader.readAsDataURL(file);
  }, []);

  const handleLogoClear = useCallback(() => {
    setLogoUrl(null);
    if (fileRef.current) fileRef.current.value = '';
  }, []);

  return (
    <section id="simulador" className="simulator-section">
      <div className="container">
        <div className="section-header">
          <h2>Veja como ficaria a sua plataforma</h2>
          <p>
            Digite o nome da sua empresa, escolha um layout e uma paleta de cores. É assim que a
            plataforma chega na sua equipe: com a sua marca e o seu processo.
          </p>
        </div>

        <div className="simulator-layout">
          {/* ── Controls ─────────────────────────────────── */}
          <div className="sim-controls glass" ref={controlsRef}>
            <label className="sim-label" htmlFor="sim-name">
              Nome da sua empresa
            </label>
            <input
              id="sim-name"
              className="sim-input"
              type="text"
              maxLength={32}
              placeholder="Ex.: Pinheiro & Cia"
              value={name}
              onChange={e => setName(e.target.value)}
            />

            <span className="sim-label">Logo da empresa</span>
            <div className="sim-logo-upload">
              <input
                ref={fileRef}
                type="file"
                accept="image/*"
                id="sim-logo"
                onChange={handleLogoUpload}
                className="sim-logo-file"
              />
              <label htmlFor="sim-logo" className="sim-logo-area">
                {logoUrl ? (
                  <img src={logoUrl} alt="Logo" className="sim-logo-img" />
                ) : (
                  <div className="sim-logo-placeholder">
                    <svg
                      viewBox="0 0 24 24"
                      width="20"
                      height="20"
                      fill="none"
                      stroke="currentColor"
                      strokeWidth="1.5"
                    >
                      <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" strokeLinecap="round" />
                      <polyline
                        points="17 8 12 3 7 8"
                        strokeLinecap="round"
                        strokeLinejoin="round"
                      />
                      <line x1="12" y1="3" x2="12" y2="15" strokeLinecap="round" />
                    </svg>
                    <span>Clique para enviar</span>
                  </div>
                )}
              </label>
              {logoUrl && (
                <button type="button" className="sim-logo-clear" onClick={handleLogoClear}>
                  ×
                </button>
              )}
            </div>

            <span className="sim-label">Modelo de layout</span>
            <div className="sim-layout-grid">
              {[
                { id: 'dashboard', label: 'Dashboard' },
                { id: 'conversations', label: 'Conversas' },
                { id: 'cnpj', label: 'Consulta CNPJ' },
              ].map(opt => (
                <button
                  key={opt.id}
                  type="button"
                  className={`sim-layout-option${layout === opt.id ? ' active' : ''}`}
                  onClick={() => setLayout(opt.id)}
                >
                  <LayoutIcon type={opt.id} />
                  {opt.label}
                </button>
              ))}
            </div>

            <span className="sim-label">Paleta de cores</span>
            <div className="sim-palettes-grid">
              {PALETTES.map(p => (
                <button
                  key={p.id}
                  type="button"
                  className={`sim-palette-option${paletteId === p.id ? ' active' : ''}`}
                  onClick={() => setPaletteId(p.id)}
                >
                  <span className="sim-palette-swatch" style={{ background: p.primary }} />
                  <span className="sim-palette-name">{p.name}</span>
                </button>
              ))}
            </div>

            <span className="sim-label">Tema do preview</span>
            <div className="sim-theme-toggle">
              <button
                type="button"
                className={`sim-theme-option${previewDark ? ' active' : ''}`}
                onClick={() => setPreviewDark(true)}
              >
                <svg
                  viewBox="0 0 24 24"
                  width="14"
                  height="14"
                  fill="none"
                  stroke="currentColor"
                  strokeWidth="2"
                  aria-hidden
                >
                  <path
                    d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"
                    strokeLinecap="round"
                    strokeLinejoin="round"
                  />
                </svg>
                Escuro
              </button>
              <button
                type="button"
                className={`sim-theme-option${!previewDark ? ' active' : ''}`}
                onClick={() => setPreviewDark(false)}
              >
                <svg
                  viewBox="0 0 24 24"
                  width="14"
                  height="14"
                  fill="none"
                  stroke="currentColor"
                  strokeWidth="2"
                  aria-hidden
                >
                  <circle cx="12" cy="12" r="5" />
                  <path
                    d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"
                    strokeLinecap="round"
                  />
                </svg>
                Claro
              </button>
            </div>

            <div className="sim-hint">
              <p>
                Isso é um preview navegável do que entregamos. A plataforma real é montada sob
                medida com os dados do seu processo, no seu ritmo.
              </p>
              <a href={mailtoLeadInquiry} className="btn btn-ghost btn-sm" data-observe-cta="sim">
                Agendar reunião
              </a>
            </div>
          </div>

          {/* ── Preview ─────────────────────────────────── */}
          <div
            className="sim-preview"
            style={{
              '--sim-accent': primary,
              '--sim-secondary': secondary,
              ...simPalette,
              ...(previewDark ? {} : { colorScheme: 'light' }),
            }}
          >
            <div className="sim-chrome">
              <span className="sim-dot red" />
              <span className="sim-dot amber" />
              <span className="sim-dot green" />
              <span className="sim-url">
                app.{displayName.toLowerCase().replace(/[^a-z0-9]/g, '') || 'suaempresa'}.com.br
              </span>
            </div>

            <div className="sim-app" style={{ height: Math.max(460, controlsHeight) }}>
              <div className="sim-topbar">
                <div className="sim-logo-cell" style={{ background: primary }}>
                  {logoUrl ? <img src={logoUrl} alt="" className="sim-topbar-logo" /> : <Mark />}
                </div>
                <span className="sim-brand-name">{displayName}</span>
                <span className="sim-brand-sub">Plataforma</span>
                <div className="sim-avatar small" style={{ marginLeft: 'auto' }}>
                  U
                </div>
              </div>

              <div className="sim-main">
                {layout === 'dashboard' && (
                  <DashboardView primary={primary} secondary={secondary} />
                )}
                {layout === 'conversations' && <ConversationsView primary={primary} />}
                {layout === 'cnpj' && <CnpjView primary={primary} />}
              </div>

              <div className="sim-statusbar">
                <span>
                  Montado para <strong>{displayName}</strong>
                </span>
                <span className="sim-live-dot" />
                Operado pela Igara
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  );
}
